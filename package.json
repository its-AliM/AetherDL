{
  "name": "aether-dl",
  "version": "1.0.0",
  "description": "AetherDL - Universal yt-dlp Media Studio & Complete Command Suite",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "schema:generate": "python tools/parse_schema.py && python tools/enrich_schema.py"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "yt-dlp",
    "aetherdl",
    "media-studio",
    "video-downloader",
    "react",
    "vite",
    "tailwind",
    "ffmpeg",
    "sponsorblock"
  ],
  "author": "AetherDL Team",
  "license": "MIT"
}
